# Template for backend/.env, the ONLY thing that differs between dev and prod.
# Copy to backend/.env and fill in. Never commit the real .env (git-ignored).
#
#   Local dev:  cp backend/.env.example backend/.env   (then dev.bat)
#   Server:     cp backend/.env.example backend/.env   (then docker compose up)
#
# No quotes around values. No spaces around "=".

# ── Django ───────────────────────────────────────────────────────────────────
# Long random string, different per environment. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# dev: True    prod: False
DEBUG=False

# Comma-separated hostnames, no scheme.
#   dev:  127.0.0.1,localhost
#   prod: manojshendre.com,www.manojshendre.com
ALLOWED_HOSTS=manojshendre.com,www.manojshendre.com

# Comma-separated origins WITH scheme.
#   dev:  http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
#   prod: https://manojshendre.com,https://www.manojshendre.com
CSRF_TRUSTED_ORIGINS=https://manojshendre.com,https://www.manojshendre.com

# ── Database (Supabase: Project → Connect) ────────────────────────────────────
# Use the dev project's values locally and the prod project's on the server.
# If the server can't reach db.<ref>.supabase.co (it's IPv6-only on the free
# tier), use the "Session pooler" values instead: host
# aws-0-<region>.pooler.supabase.com, port 5432, user postgres.<project-ref>.
POSTGRES_DB=postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# ── Readar ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
CHAT_WS_PORT=8041
